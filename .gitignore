# Sorties de build et fichiers générés
build/
builds/
__pycache__/
*.pyc

# Captures d'écran et rendus de test
captures/

# Anciens prototypes archivés localement (intégrés à main ; historique DDGI dans la branche archive/ddgi-study)
_archive/

# Dossiers d'échange locaux (références, dépôts pour Claude)
00 - REFERENCES/
01 - INBOX/

# Intel Open Image Denoise : DLL précompilées téléchargées par build.bat (tools\fetch_oidn.ps1), ~80 Mo
third_party/oidn/

# Fichiers de préférences générés à l'exécution
*.ini
vp3d_prefs.txt
*.lnk

# HDRI de test (Poly Haven, CC0) : lourds, gardes hors du suivi
assets/hdri/

# Sondes cuites (baked probes) ecrites par l editeur (game/probes/<scene>.probes, ~10 Mo par scene) : a versionner a la demande
game/probes/
