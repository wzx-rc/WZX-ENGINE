{
  "name": "plasma-orks-builder",
  "productName": "Plasma Orks Builder",
  "version": "0.2.0",
  "description": "PlasmaOrk Builder pour Windows : le builder web avec le path tracing activé.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-app": "node build.mjs",
    "start": "node build.mjs && electron .",
    "pack:win": "node build.mjs && electron-packager . \"Plasma Orks Builder\" --platform=win32 --arch=x64 --out=dist --overwrite --asar --ignore=\"^/dist\" --ignore=\"^/build\\.mjs\" --ignore=\"^/README\\.md\" --ignore=\"^/assets\" --ignore=\"^/node_modules\""
  },
  "devDependencies": {
    "@electron/packager": "18.3.6",
    "electron": "33.2.1",
    "three": "0.180.0",
    "three-gpu-pathtracer": "0.0.24",
    "three-mesh-bvh": "0.9.1"
  }
}
